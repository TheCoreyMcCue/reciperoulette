# ─────────────────────────────────────────────────────────────────────────────
# reciperoulette configuration
# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.
#
# NOTE: we deliberately do NOT use AWS_REGION / AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY because Vercel reserves those names.
# ─────────────────────────────────────────────────────────────────────────────

# AWS region the DynamoDB table lives in. Pick one close to your Vercel
# functions region (Vercel defaults to iad1 = us-east-1; for the Netherlands,
# eu-central-1 with Vercel region fra1 is a good pair).
DYNAMO_REGION=eu-central-1

# Access key for an IAM user restricted to this table (policy in README.md).
DYNAMO_ACCESS_KEY_ID=
DYNAMO_SECRET_ACCESS_KEY=

# Table name. `pnpm db:setup` creates it if it doesn't exist.
DYNAMO_TABLE_NAME=reciperoulette

# Optional: point at DynamoDB Local for offline development, e.g.
#   docker run -p 8000:8000 amazon/dynamodb-local
#   DYNAMO_ENDPOINT=http://localhost:8000
# Leave empty to use real AWS.
DYNAMO_ENDPOINT=

# Anthropic API key (https://console.anthropic.com → API keys).
ANTHROPIC_API_KEY=

# Claude model used for recipe parsing (text + vision).
ANTHROPIC_MODEL=claude-sonnet-5-5

# Max AI parse calls per household per day (cost control).
AI_DAILY_PARSE_LIMIT=50

# Secret used to hash session tokens and invite codes (HMAC-SHA256).
# Generate with:  openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=

# Public URL of the app, used to build invite links.
# Local: http://localhost:3000   Vercel: https://your-app.vercel.app
APP_URL=http://localhost:3000

# Comma-separated emails allowed to create a NEW household without an invite.
# Everyone else can only sign up through an invite link (/join/<code>).
SIGNUP_ALLOWED_EMAILS=you@example.com
